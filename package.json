{
  "name": "mcart-tools",
  "private": true,
  "version": "0.1.1-beta.1",
  "type": "module",
  "description": "Minecraft 网页工具集 · 方块像素画 / 地图画 / 方块图鉴 / 结构查看器",
  "scripts": {
    "sync": "npm run sync:textures && npm run sync:legacy",
    "sync:textures": "node scripts/sync-textures.mjs",
    "sync:legacy": "node scripts/sync-legacy.mjs",
    "predev": "npm run sync",
    "dev": "vitepress dev docs",
    "prebuild": "node scripts/clean-dist.mjs && npm run sync",
    "build": "npm run typecheck && vitepress build docs",
    "preview": "vitepress preview docs",
    "typecheck": "vue-tsc --noEmit",
    "pretest": "npm run sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/make-fixtures.mjs",
    "postbuild": "node scripts/copy-textures.mjs"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
