# 系统
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp

# 依赖与构建产物
node_modules/
dist/
docs/.vitepress/dist/
docs/.vitepress/cache/
*.local

# 本地工作区数据（不是缓存，但不该进仓库）
.workbuddy/

# 贴图同步出来的副本（源在 原版材质/，由 npm run sync:textures 生成）
src/assets/textures/

# 旧版单文件页面的副本（源在 public/legacy/，由 npm run sync:legacy 生成）
docs/public/legacy/

# 构建中间产物（由 .build/*.py 重新生成）
.build/blocks.js
.build/tex.js

# 识别表的中间数据（scripts/build-block-extras.mjs 联网自动拉取，不进仓库）
.build/mc-tree.json
.build/mc-ids.txt
.build/mc-tex.txt
.build/item-tex.txt
.build/tex-need.txt
.build/zh_cn.json
.build/en_us.json

# 临时测试脚本
.build/t*.js

# VitePress 加载 config 时的临时文件（构建被打断会留下）
docs/.vitepress/config.mts.timestamp-*
